# Copy to server/.env and fill in. Never commit .env.

# Supabase > Connect > "Session pooler" URI (port 5432), with your DB password filled in
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Postgres schema the app's tables live in. Tests override this to cast_ops_test,
# so they can wipe their own tables without touching dev data.
DB_SCHEMA=cast_ops

# Optional: path to Supabase's CA certificate (Project Settings > Database > SSL)
# to fully verify the server's TLS certificate.
# DATABASE_CA_CERT=./supabase-ca.crt

PORT=4000
